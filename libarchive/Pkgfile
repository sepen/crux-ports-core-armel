# Description: Library to create and read several archive formats
# URL: https://www.libarchive.org/
# Maintainer: CRUX System Team, core-ports at crux dot nu
# Depends on: acl bzip2 lzo zstd


#
# NOTE: This is a temporary Pkgfile used to build crux-armel
#

name=libarchive
version=3.8.8
release=1
source=(https://github.com/libarchive/libarchive/releases/download/v$version/$name-$version.tar.xz)

build() {
  cd $name-$version

  ./configure \
    --prefix=/usr \
    --without-xml2 \
    --without-nettle \
    --without-lzo2 \
    --without-lz4 \
    --without-expat \
    --disable-static

  make
  make DESTDIR=$PKG install
}
